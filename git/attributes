# Auto-detect text files and normalize line endings
* text=auto eol=lf

# C / C++ source
*.c      text diff=cpp
*.cpp    text diff=cpp
*.cc     text diff=cpp
*.cxx    text diff=cpp
*.h      text diff=cpp
*.hpp    text diff=cpp
*.hh     text diff=cpp
*.hxx    text diff=cpp
*.inl    text diff=cpp
*.ipp    text diff=cpp
*.cu     text diff=cpp
*.cuh    text diff=cpp

# CMake
CMakeLists.txt     text
*.cmake           text
*.cmake.in        text eol=lf

# Python
*.py       text diff=python
*.pyi      text diff=python
pyproject.toml   text

# YAML / XML / launch
*.yaml      text
*.yml       text
*.xml       text
*.urdf      text
*.xacro     text
*.sdf       text
*.rviz      text
*.launch.py text diff=python

# Shell / config
*.sh       text eol=lf
*.zsh      text eol=lf
*.bash     text eol=lf
*.cmake.in text eol=lf
*.json     text
*.toml     text
*.md       text

# Binary files that must never be diffed
*.so      binary
*.a       binary
*.o       binary
*.png     binary
*.jpg     binary
*.pdf     binary
*.dae     binary
*.stl     binary
*.urdf.gz binary
*.launch   binary
